# Variáveis da API (validadas na subida por src/lib/env.ts — fail fast).
# Integrações opcionais podem ficar EM BRANCO (= desligadas), mas cada grupo é
# tudo-ou-nada: preencher só metade das variáveis derruba o boot.
# Linhas marcadas "[compose]" só são lidas pelo docker compose / Makefile, não pela API.

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Grava tambem em logs/<nome>.log. Em dev e sempre ligado; em producao o padrao
# e so stdout (o docker coleta) — true aqui liga o arquivo tambem.
LOG_FILE=false

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3080
# URL publica da API. Em branco assume BETTER_AUTH_URL (e vice-versa).
API_URL=http://localhost:3080
# Origens aceitas pelo CORS (separadas por virgula). Em branco assume a origem
# de FRONTEND_URL — so preencha se houver mais de uma origem.
API_CORS=
# Documentacao em /docs (Scalar) + /docs/openapi.json. Em producao, se a API
# for publica, defina false: /docs passa a responder 404.
DOCS_ENABLED=true

# ── Auth (better-auth) ───────────────────────────────────────────────────────
# Em branco assume API_URL.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-chars   # producao: openssl rand -hex 32
# Origens confiaveis do better-auth e do CSRF (separadas por virgula). Em branco
# assume a origem de FRONTEND_URL.
TRUSTED_ORIGINS=
COOKIE_DOMAIN=                                          # ex: .meuapp.fslab.dev (producao)
FRONTEND_URL=http://localhost:3000                      # usado nos e-mails de reset de senha
# Cadastro público (POST /auth/sign-up e primeiro login com Google).
# false (default): contas só nascem pelo painel (admin) ou pelo seed.
AUTH_SIGNUP_ENABLED=false

# ── OAuth Google (opcional; os dois juntos ou nenhum) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin inicial (seed de usuários) ─────────────────────────────────────────
# Conta criada por `npm run db:setup` / serviço migrate do compose. Em branco
# (dev) vale admin@example.com / 102030fs. Em PRODUÇÃO os três são obrigatórios
# e a senha de demonstração é recusada. Só usados na criação — depois, o papel
# e a senha são geridos pelo painel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Docker (nomes dos containers) [compose] ──────────────────────────────────
CONTAINER_APP=api_template
CONTAINER_DB=db_template_ia
CONTAINER_FRONT=front_template

# ── Front em producao (docker-compose.prod.yml) [compose] ───────────────────
# Viram NEXT_PUBLIC_* no BUILD da imagem do front (valores vistos pelo navegador).
FRONT_API_URL=http://localhost:3080
FRONT_APP_URL=http://localhost:3000
FRONT_PORT=3000
FRONT_GOOGLE_LOGIN=false
# Pílula "Ambiente de …" no canto da tela: development | staging | preview. Em branco não aparece.
FRONT_AMBIENTE=
# Tamanhos de página das listagens (o primeiro é o padrão). Em branco: 10,25,50,100.
FRONT_PAGE_SIZES=
# Mostra o link "Criar conta" no login — mantenha igual a AUTH_SIGNUP_ENABLED.
FRONT_SIGNUP_ENABLED=false
FRONT_APP_NOME=Template IA                  # [compose] nome do app (aba, menu, login)

# ── Banco de dados ───────────────────────────────────────────────────────────
# A API le DATABASE_URL. Em branco, monta a partir de POSTGRES_USER/PASSWORD/DB
# (host localhost, porta POSTGRES_PORT) — em dev basta preencher os POSTGRES_*.
# Preencha quando o banco esta em outro host (producao: o compose monta a URL).
DATABASE_URL=
POSTGRES_USER=user_template          # [compose]
POSTGRES_PASSWORD=102030fs           # [compose] producao recusa esta senha
POSTGRES_DB=db_template              # [compose]
POSTGRES_PORT=5432                   # [compose] porta exposta no host (dev)
# Pool do Postgres: conexoes maximas e tempo maximo de uma query em ms (0 desliga).
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# ── Banco de TESTES (integracao: npm run test:integration) ──────────────────
# Servico db_test do docker-compose.yml; o nome do banco PRECISA conter "test".
DATABASE_URL_TEST=postgresql://user_template:102030fs@localhost:5434/db_template_test
POSTGRES_DB_TEST=db_template_test        # [compose]
POSTGRES_PORT_TEST=5434                  # [compose]
CONTAINER_DB_TEST=db_template_ia_test    # [compose]
# Como db:setup aplica o schema: migrate (default — drizzle/ versionado) ou push.
DB_SCHEMA_MODE=migrate

# ── Seguranca HTTP ───────────────────────────────────────────────────────────
# Headers de seguranca (secureHeaders). true por padrao.
HELMET_ENABLED=true
# Atras de reverse proxy (nginx/traefik), numero de hops para o IP real
# chegar ao rate limit (normalmente 1). Vazio = acesso direto (dev).
TRUST_PROXY=
# Liga/desliga TODOS os limiters (auth, global e /logs). false = nenhum registrado.
RATE_LIMIT_ENABLED=true
# Rate limit de auth: conta APENAS tentativas FALHAS de login/cadastro/reset por IP
# (logins ok nao gastam cota — empresas atras de um IP so nao sao punidas).
# 0 desliga. Janela em minutos compartilhada pelos limiters.
RATE_LIMIT_JANELA_MIN=15
RATE_LIMIT_AUTH_MAX=20
# Limite global de requests por IP na janela (0 = desligado, o default —
# limite global por IP pune escritorios inteiros atras de NAT).
RATE_LIMIT_GLOBAL_MAX=0

# ── Logs: OpenObserve (opcional; URL e token juntos) ─────────────────────────
# Sem eles os logs ficam apenas locais (stdout + arquivo em logs/).
# OPENOBSERVE_TOKEN: base64(email:senha) — o header "Basic " e adicionado sozinho.
OPENOBSERVE_URL=
OPENOBSERVE_TOKEN=
OPENOBSERVE_ORG=default

# ── Armazenamento de objetos: Garage (S3-compativel; opcional) ───────────────
# ENDPOINT, BUCKET_NAME, ACCESS_KEY_ID e SECRET_ACCESS_KEY juntos ou nenhum.
OBJECTS_ENDPOINT=                    # ex: https://s3.fslab.dev
OBJECTS_BUCKET_NAME=                 # ex: template-ia
OBJECTS_PUBLIC_URL=                  # ex: https://template-ia.web.fslab.dev (opcional)
OBJECTS_ACCESS_KEY_ID=
OBJECTS_SECRET_ACCESS_KEY=
OBJECTS_REGION=garage
# Admin API do Garage (criar buckets/chaves via codigo; opcional; os dois juntos)
GARAGE_URL=                          # ex: https://garage.fslab.dev
GARAGE_ADMIN_KEY=

# ── E-mail (FS-Mail — POST para a API REST; opcional; URL e key juntas) ──────
# Sem eles o envio e apenas logado (modo dev).
FSMAIL_URL=                          # ex: https://fs-mail.fslab.dev
FSMAIL_API_KEY=
FSMAIL_FROM=nao-responda@fslab.dev
