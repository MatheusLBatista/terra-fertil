{
  "name": "template-ia-api",
  "version": "1.0.0",
  "description": "API do template — Hono + Drizzle + better-auth + CASL",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "tsx src/scripts/envCheck.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:triggers": "tsx src/scripts/applyTriggers.ts",
    "db:setup": "tsx src/scripts/setupDb.ts",
    "db:reset": "tsx src/scripts/resetDb.ts && bun run db:setup",
    "db:seed": "tsx src/seeds/index.ts",
    "db:seed:estados": "tsx src/seeds/estados.ts",
    "db:seed:municipios": "tsx src/seeds/municipios.ts",
    "db:seed:usuarios": "tsx src/seeds/usuarios.ts",
    "db:seed:papeis": "tsx src/seeds/papeis.ts",
    "ibge:download": "tsx src/scripts/ibgeDownload.ts",
    "openapi:export": "tsx src/scripts/exportOpenapi.ts",
    "relatorio:rotas": "tsx src/scripts/analyzeRoutes.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@casl/ability": "^7.0.1",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "hono-rate-limiter": "^0.5.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
