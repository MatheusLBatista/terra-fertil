{
  "compilerOptions": {
    "target": "es2024",
    "module": "NodeNext",
    "rootDir": "./",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"]
}
