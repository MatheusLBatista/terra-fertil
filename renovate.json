{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":timezone(America/Sao_Paulo)"],
  "description": "Atualizações semanais; pacotes que andam juntos sobem no mesmo PR; devDependencies minor/patch com automerge (o CI precisa passar).",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "drizzle",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"]
    },
    {
      "groupName": "better-auth",
      "matchPackageNames": ["better-auth"]
    },
    {
      "groupName": "hono",
      "matchPackageNames": ["hono", "hono-rate-limiter", "@hono/**"]
    },
    {
      "groupName": "tanstack",
      "matchPackageNames": ["@tanstack/**"]
    },
    {
      "groupName": "next",
      "matchPackageNames": ["next", "eslint-config-next"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
