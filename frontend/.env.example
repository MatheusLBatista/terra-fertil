PORT=3000

# URL base da API do back-end (servidor, cliente e better-auth). Obrigatória.
NEXT_PUBLIC_API_URL=http://localhost:3080
# DEPRECIADA — era a URL do better-auth no cliente; hoje vale NEXT_PUBLIC_API_URL.
# Só é lida como fallback quando NEXT_PUBLIC_API_URL está em branco. Pode apagar.
# NEXT_PUBLIC_API_URL_CLIENT=
# URL pública deste app (callbacks de OAuth, links de e-mail). Obrigatória.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mostra o botão "Continuar com o Google" no login. Só ligue com
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET válidos no .env do back-end.
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Pílula "Ambiente de …" no canto da tela: development | staging | preview.
# Em branco (produção) não aparece nada.
NEXT_PUBLIC_AMBIENTE=development

# Tamanhos de página das listagens ("Itens por página"); o primeiro é o padrão.
# Em branco vale 10,25,50,100.
NEXT_PUBLIC_PAGE_SIZES=

# Nome da aplicação (título da aba, menu lateral e telas de login).
# Em branco vale "Terra Fértil".
NEXT_PUBLIC_APP_NOME=

# `true` mostra o link "Criar conta" no login e libera o cadastro em /registrar
# (o back-end também precisa aceitar sign-up). Em branco/false: /registrar vai para /login.
NEXT_PUBLIC_SIGNUP_ENABLED=false

# Fuso horário das datas exibidas (IANA, ex.: America/Porto_Velho).
# Em branco usa o fuso do navegador de quem está vendo.
NEXT_PUBLIC_TIMEZONE=

# Tema inicial: dark | light | system (system segue o SO). Em branco vale dark.
NEXT_PUBLIC_TEMA_PADRAO=
